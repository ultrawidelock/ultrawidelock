CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

#disable BT connection reattempt
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Enable L2CAP Connection-Oriented Channels: the credential-auth transaction
# rides an L2CAP CoC on the reader's SPSM. Default esp-matter NimBLE leaves this at
# 0, so ble_l2cap_create_server() returns BLE_HS_ENOTSUP. Match the bench reader app.
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=2

# The credential reader runs its P-256 credential-auth (ECDH + ECDSA sign/verify + HKDF)
# inside the NimBLE L2CAP callback, i.e. on the nimble_host task. The 4096-byte
# default overflows that stack mid-transaction; the software P-256 path needs more.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=16384

# Trap stack overflows where they happen, not at the next context switch. The canary
# check (FREERTOS_CHECK_STACKOVERFLOW_CANARY) only runs on a switch, so a task that
# overruns and then returns through the clobbered frame crashes with a corrupted
# backtrace and no task name. The watchpoint panics on the first write into the last
# 32 bytes of any task stack and names the culprit.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

#enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Disable the CHIP shell: main/app_shell.cpp runs an esp_console REPL on the
# console UART instead, and only one reader of that UART can exist.
CONFIG_ENABLE_CHIP_SHELL=n

# This example only use 2 dynamic endpoints
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2

#enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Button
CONFIG_BUTTON_PERIOD_TIME_MS=20
CONFIG_BUTTON_LONG_PRESS_TIME_MS=5000

# disable softap by default
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Enable OTA Requestor
CONFIG_ENABLE_OTA_REQUESTOR=y

# Use compact attribute storage mode
CONFIG_ESP_MATTER_NVS_USE_COMPACT_ATTR_STORAGE=y

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

CONFIG_ENABLE_WIFI_AP=n

# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
# unique local addresses for fabrics(MAX_FABRIC), a link local address(1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# ESP32-DevKitC Settings
# Buttons
CONFIG_BSP_BUTTONS_NUM=1
CONFIG_BSP_BUTTON_1_TYPE_GPIO=y
CONFIG_BSP_BUTTON_1_GPIO=0
CONFIG_BSP_BUTTON_1_LEVEL=0
# LEDs
CONFIG_BSP_LEDS_NUM=0

# configurations required for diagnostic logs cluster
# Enable the diagnostic logs transfer over BDX protocol
CONFIG_CHIP_ENABLE_BDX_LOG_TRANSFER=y

CONFIG_ESP32_ENABLE_COREDUMP_TO_FLASH=y
CONFIG_ESP32_COREDUMP_DATA_FORMAT_ELF=y

# disable groupcast cluster until verified
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n

# Advertise the credential protocol (Apple Home Key) Provisioning + BLE-UWB and register the reader delegate
CONFIG_ENABLE_ULTRAWIDELOCK_BLE_UWB=y

# The step-up phase is how a second device on the owner's Apple ID (a Watch) gets
# in: the hub never sends a SetCredential for it, so the reader asks the device
# for its Access Document and learns the key the home's issuer signed.
CONFIG_ULTRAWIDELOCK_CRED_STEPUP=y

# Keep BLE up after commissioning (do NOT deinit/reclaim it). Required for the
# credential reader to coexist on Matter's NimBLE host; also, reclaiming BLE makes any
# later nimble_port_init() crash the controller (btdm_controller_init fault).
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# --- walk-up latency -----------------------------------------------------------

# The console UART is installed with a zero-length TX buffer, so every log write
# blocks the calling task at 115200 baud. A walk-up used to emit ~5-7 KB of INFO
# logs from inside the NimBLE-host protocol callbacks (~500 ms of UART stall,
# contending with the UWB responder's ~1.8 ms slot deadline). Default to WARN;
# keep the compile-time ceiling at DEBUG so the shell's `log <tag> <level>`
# command can bring diagnostics back at runtime without a reflash.
# NB: WARN also compiles CHIP Progress/Detail logging out of the CHIP library
# (CHIP_LOG_DEFAULT_LEVEL is Kconfig-range-capped to LOG_DEFAULT_LEVEL and
# gates chip_progress_logging in the GN build), so no runtime level restores
# chip[..] progress logs; the onboarding codes are printf'd in app_main
# instead. For full chip diagnostics set CONFIG_LOG_DEFAULT_LEVEL_INFO=y here
# and rebuild.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# 1 ms tick (the sibling esp32-idf port already runs 1000 Hz): the default
# 100 Hz rounds every vTaskDelay/timeout up to 10 ms steps, which is real
# latency in the notify-timeout unlock path and BLE glue.
CONFIG_FREERTOS_HZ=1000

# The S3 has no P-256 accelerator, so all four per-session scalar mults are
# software: 240 MHz over the 160 MHz default is ~50% faster auth crypto.
# Fixed-point optimisation speeds the base-point mults (keygen/sign) further.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y

# RSSI power-gate thresholds, measured rather than guessed: 274 paired
# range/RSSI samples on the bench rig, reduced with
# `power_profile.py <log> --calibrate`.for the curve
# and for why -55 beats the better-separating -50. Per-room and per-handset;
# re-run the calibration for a different rig.
#
# Pinned here because a Kconfig `default` only seeds a FRESH sdkconfig. An
# existing sdkconfig keeps its old value forever, so changing the default alone
# silently ships the old thresholds.
CONFIG_ULTRAWIDELOCK_RSSI_GATE_OPEN_DBM=-55
CONFIG_ULTRAWIDELOCK_RSSI_GATE_CLOSE_DBM=-65

# The hold cap takes the trade the Kconfig help describes, and it does so for
# the Apple Watch. The thresholds above were calibrated against an iPhone; a
# Watch transmits well below it and can sit between -55 and -65 dBm at the
# door, where an unbounded hold (the Kconfig default, 0) never releases
# AP-Completed. The phone's patience is ~1.9 s and its retry then repeats the
# same hold, so "let it come back closer" never converges for that handset:
# the observed result was a reconnect every 3-4 s and no UWB. 1500 ms plus the
# 250 ms poll releases at ~1.7 s, inside the 1873 ms measured on the bench.
CONFIG_ULTRAWIDELOCK_RSSI_GATE_MAX_HOLD_MS=1500

# cred_housekeeping runs mbedTLS's software P-256 keygen (the spare ephemeral
# refill) and the NVS store. The 3072-byte source default is a Zephyr/PSA
# figure; on this port it overran (stack canary in cred_housekeeping on an
# ESP32-S3). 6144 is what the step-up worker already uses for the same curve.
CONFIG_ULTRAWIDELOCK_CRED_HOUSEKEEPING_STACK_SIZE=6144

# Two-anchor round: the lock advertises Number_Responder_Nodes=2, reserving
# slot 3 for the satellite's Response_1 and moving the phone's Final out one
# slot. The phone honours the layout but only ever reports responder 0 (proven
# on the nRF bench, cred_round_config.h), so a lock with no satellite powered
# grants exactly as the 1:1 round does -- the empty slot is ordinary RF
# silence. Both knobs bake into the SaltedHash: the satellite image must be
# built with the same count (examples/esp32/satellite pins 2), and =1 here
# restores the single-anchor round. This node answers in slot 0.
CONFIG_ULTRAWIDELOCK_NUM_RESPONDERS=2
CONFIG_ULTRAWIDELOCK_RESPONDER_INDEX=0

# ---- over-the-air updates, over Bluetooth --------------------------------
#
# The ESP32 side of https://ultrawidelock.com/flash/index.html. Adds a GATT
# service that takes a signed application image and writes it into the OTA slot
# this image is not running from, then points the bootloader at it. Same wire
# protocol as the DWM3001CDK, so one page drives both.
#
# NOT the same thing as CONFIG_ENABLE_OTA_REQUESTOR above. That is Matter OTA:
# BDX from a commissioned provider node over Wi-Fi, which is the right path for
# a fleet and useless to someone with a board and a browser, because a web page
# cannot join a Matter fabric. The two coexist; they share the ota_0/ota_1 slots
# and nothing else.
#
# The window is opened by DOUBLE-CLICKING the board's button. The long press is
# already the commissioning window and stays that way.
CONFIG_ULTRAWIDELOCK_DFU_ESP32=y

# Roll back to the previous slot if an update does not reach the end of
# app_main. Without this a bad image is simply what the lock now runs, and the
# only way back is a cable -- which is the one thing the whole feature exists to
# avoid. ultrawidelock_dfu_esp32_confirm() is what cancels the rollback.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
